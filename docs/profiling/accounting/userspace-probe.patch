+fn group_counts(columns: &[Column], positions: Option<(usize, usize)>) -> Option<[u64; 3]> {
+    let (version, packets) = positions?;
+    let (Column::Integer(versions), Column::Integer(counts)) =
+        (columns.get(version)?, columns.get(packets)?)
+    else {
+        return None;
+    };
+    if versions.len() != counts.len() {
+        return None;
+    }
+    let mut totals = [versions.len() as u64, 0, 0];
+    for (&family, &count) in versions.iter().zip(counts) {
+        let index = match family {
+            4 => 1,
+            6 => 2,
+            _ => return None,
+        };
+        totals[index] = totals[index].checked_add(u64::try_from(count).ok()?)?;
+    }
